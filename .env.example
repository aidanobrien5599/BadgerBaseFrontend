# Upstream better-auth server (the api-local Hono service on Railway), e.g.
# https://api-local-production.up.railway.app — NO trailing slash.
#
# The browser never calls this host. It calls /api/auth/* on this app's own
# origin, and app/api/auth/[...all]/route.ts forwards to this URL. That is
# what makes the better-auth session cookie first-party; a cookie set by the
# API's own cross-site domain in production is dropped by the browser and is
# never sent to the Vercel origin lib/server-session.ts reads it on.
#
# This is a server-only variable (deliberately not NEXT_PUBLIC_): it replaced
# NEXT_PUBLIC_AUTH_URL, which no longer means anything now that the client
# base URL is same-origin. Required in production — next.config.mjs hard-fails
# the production build if it is unset. Must be set in Vercel before the first
# production build.

# Query API (api-local) base URL and key, used by the search/proxy routes.
API_KEY=

# Subscriptions API base URL and key, used by app/api/subscriptions/*.
#
# MUST include the /v2 suffix, e.g.
# https://api-local-production.up.railway.app/v2 — api-local mounts the
# subscription routes (/subscriptions, /course-subscription,
# /section-subscription) under /v2 since the bare-path MySQL API was deleted.
# Without the suffix every subscription call 404s.
SUBSCRIPTION_API_KEY=

# Resend API key, used to send feedback emails (app/api/feedback/route.ts).
RESEND_API_KEY=

# PostHog analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# The BadgerBase API (Hono, on Railway in production). One base URL for
# course queries, autocomplete, subscriptions and the better-auth proxy —
# they are all the same service. Paths (including /v2) live in code.
API_URL=
