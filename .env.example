# better-auth server base URL. Required in production — next.config.mjs
# hard-fails the production build if this is unset. Must be set in Vercel
# before the first production build.
NEXT_PUBLIC_AUTH_URL=

# Query API (api-local) base URL and key, used by the search/proxy routes.
API_BASE_URL=
API_KEY=

# Subscriptions API base URL and key, used by app/api/subscriptions/*.
SUBSCRIPTION_URL=
SUBSCRIPTION_API_KEY=

# Resend API key, used to send feedback emails (app/api/feedback/route.ts).
RESEND_API_KEY=

# PostHog analytics.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
