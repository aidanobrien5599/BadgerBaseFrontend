# @better-auth/oauth-provider (the OAuth client plugin the login page needs to
# resume an interrupted authorization) pulls better-call@1.4.0, which declares
# an OPTIONAL peer on zod@^4. This app is on zod@^3.24.1, and npm treats that
# unmet optional peer as a hard ERESOLVE — `npm ci` fails outright, so a build
# on Vercel would fail even though nothing at runtime needs zod 4.
#
# Verified: with this flag, `npm install` and `npm ci` both succeed and resolve
# better-auth 1.7.2 (the pinned version), @better-auth/oauth-provider 1.7.3
# (matching what the API resolves), and zod 3.25.76 — no runtime change.
legacy-peer-deps=true
